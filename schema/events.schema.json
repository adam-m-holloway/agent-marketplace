{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data: events/year=YYYY/month=MM/YYYY-MM-DD.ndjson (one event per line)",
  "description": "Changes between the previous day's snapshot and today's, keyed by consumer + plugin + channel.",
  "type": "object",
  "required": ["date", "type", "consumer", "team", "channel", "plugin", "from_version", "to_version"],
  "additionalProperties": false,
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "type": { "enum": ["added", "removed", "version_changed"] },
    "consumer": { "type": "string" },
    "team": { "type": "string" },
    "channel": { "enum": ["latest", "stable"] },
    "plugin": { "type": "string" },
    "from_version": { "type": ["string", "null"] },
    "to_version": { "type": ["string", "null"] }
  }
}
