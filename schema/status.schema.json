{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plugins/<name>/status.json",
  "type": "object",
  "required": ["stage", "since"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "stage": { "enum": ["sandbox", "incubating", "published", "deprecated", "retired"] },
    "since": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "reason": { "type": "string" }
  }
}
