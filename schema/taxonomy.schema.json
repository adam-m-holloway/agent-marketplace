{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "taxonomy.json",
  "type": "object",
  "required": ["categories", "tags", "languages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "categories": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } }
  }
}
