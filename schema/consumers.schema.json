{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data: consumers/year=YYYY/month=MM/YYYY-MM-DD.ndjson (one row per line) and latest/consumers.json rows",
  "description": "Committed intent per repo (from .claude/settings.json), not what each laptop has installed.",
  "type": "object",
  "required": ["date", "consumer", "team", "channel", "marketplace", "plugin", "ref", "sha", "version", "versions_behind", "first_seen", "status"],
  "additionalProperties": false,
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "consumer": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "team": { "type": "string" },
    "channel": { "enum": ["latest", "stable"] },
    "marketplace": { "type": "string" },
    "plugin": { "type": "string" },
    "ref": { "type": ["string", "null"] },
    "sha": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "versions_behind": { "type": ["integer", "null"] },
    "first_seen": { "type": ["string", "null"] },
    "status": { "enum": ["active", "removed", "unknown"] },
    "note": { "type": "string" }
  }
}
